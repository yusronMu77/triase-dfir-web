# Copy to .env.local (ignored by git). No secrets live in web: the session is an HttpOnly cookie set by api.

# Browser-visible API origin. Leave empty to call the same origin (Caddy routes /api/v1/* to api).
# Set only for a cross-origin API; then api must allow that origin with credentials.
NEXT_PUBLIC_API_BASE_URL=

# Development without Caddy: Next rewrites /api/v1/* to this origin (server-side only, not sent to the browser).
# api's ASTRIA_PUBLIC_ORIGIN must equal the origin you open in the browser, e.g. http://localhost:3100.
ASTRIA_API_ORIGIN=
